# GitHub Actions
^\.github$

# pkgdown
^_pkgdown\.yml$
^docs$
^_pkgdown\.yaml$

# Development files
^.*\.Rproj$
^\.Rproj\.user$

# Validation docs
^biblioIntegrator_LOCAL_VALIDATION.*\.md$
^biblioIntegrator_cheatsheet\.pdf$

# Build artifacts
^BUILD[^/]*\.(log|err|txt)$
^.*\.tar\.gz$

# Python environment
^\.venv$

# IDE
^\.vscode$
^\.idea$

# OS files
^\.DS_Store$
^Thumbs\.db$

# README with badges (keep README.md but not extras)
^README\.html$

# Tutorial operacional (não faz parte do pacote)
^tutorial$
^tutorial-agronomia$
^LEIA-ME\.md$

# Artigos do site pkgdown (publicados, mas fora do tarball)
^vignettes/articles$

# Projeto Quarto dos artigos do site (nao faz parte do pacote)
^vignettes/_quarto\.yaml$